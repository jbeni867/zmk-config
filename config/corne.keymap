#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define MEDIA 3

#define LEFT_HAND  0 1 2 3 4 5  12 13 14 15 16 17  24 25 26 27 28 29  36 37 38
#define RIGHT_HAND 6 7 8 9 10 11  18 19 20 21 22 23  30 31 32 33 34 35  39 40 41

/ {
        behaviors {
                hml: home_row_mod_left {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <RIGHT_HAND>;
                        hold-trigger-on-release;
                        display-name = "Left Home Row Mod";
                };

                hmr: home_row_mod_right {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <LEFT_HAND>;
                        hold-trigger-on-release;
                        display-name = "Right Home Row Mod";
                };
        };

        conditional_layers {
                compatible = "zmk,conditional-layers";
                nav_sym_media {
                        if-layers = <NAV SYM>;
                        then-layer = <MEDIA>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                base_layer {
                        display-name = "Base";
// | TAB  Q     W     E      R T | Y U I     O     P     BSPC |
// | ESC  A/GUI S/ALT D/CTL  F G | H J K/CTL L/ALT ;/GUI '   |
// | SHFT Z     X     C      V B | N M ,     .     /     DEL  |
//                 | GUI NAV SPC | SHFT ENT SYM |
                        bindings = <
&kp TAB       &kp Q        &kp W       &kp E        &kp R &kp T   &kp Y &kp U &kp I         &kp O       &kp P          &kp BSPC
&kp ESC       &hml LGUI A  &hml LALT S &hml LCTRL D &kp F &kp G   &kp H &kp J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &kp SQT
&kp LSHFT     &kp Z        &kp X       &kp C        &kp V &kp B   &kp N &kp M &kp COMMA     &kp DOT     &kp FSLH       &kp DEL
                                  &kp LGUI &mo NAV &kp SPACE   &kp RSHFT &kp RET &mo SYM
                        >;
                };

                nav_layer {
                        display-name = "Nav";
// | TAB  F1  F2  F3  F4 F5 | F6   F7   F8   F9    F10 BSPC |
// | ESC  --  --  --  -- -- | LEFT DOWN UP   RIGHT --  --   |
// | SHFT F11 F12 --  -- -- | HOME PGDN PGUP END   DEL DEL  |
//              | GUI NAV SPC | SHFT ENT SYM |
                        bindings = <
&kp TAB       &kp F1  &kp F2  &kp F3 &kp F4 &kp F5   &kp F6   &kp F7    &kp F8    &kp F9    &kp F10 &kp BSPC
&kp ESC       &trans  &trans  &trans &trans &trans   &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &trans  &trans
&kp LSHFT     &kp F11 &kp F12 &trans &trans &trans   &kp HOME &kp PG_DN &kp PG_UP &kp END   &kp DEL &kp DEL
                              &kp LGUI &trans &kp SPACE   &kp RSHFT &kp RET &mo SYM
                        >;
                };

                symbol_layer {
                        display-name = "Symbols";
// | TAB  ! @ # $ % | ^ & * ( ) BSPC |
// | ESC  ` { [ ( < | > ) ] } ' '    |
// | SHFT ~ - _ = + | \ | ; : ? DEL |
//       | GUI NAV SPC | SHFT ENT SYM |
                        bindings = <
&kp TAB       &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT   &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR  &kp BSPC
&kp ESC       &kp GRAVE &kp LBRC  &kp LBKT  &kp LPAR  &kp LT      &kp GT    &kp RPAR &kp RBKT  &kp RBRC  &kp SQT   &kp SQT
&kp LSHFT     &kp TILDE &kp MINUS &kp UNDER &kp EQUAL &kp PLUS    &kp BSLH  &kp PIPE &kp SEMI  &kp COLON &kp QMARK &kp DEL
                                &kp LGUI &mo NAV &kp SPACE   &kp RSHFT &kp RET &trans
                        >;
                };

                media_layer {
                        display-name = "Media";
// | -- BTCLR BT0 BT1 BT2 BT3 | BT4 --    --    --    --   --     |
// | -- --    --  --  --  --  | PREV PLAY  NEXT  MUTE  --   UNLOCK |
// | -- --    --  --  --  --  | BRI- VOL-  VOL+  BRI+  --   --     |
//                 | GUI NAV -- | -- -- SYM |
                        bindings = <
&trans &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3   &bt BT_SEL 4 &trans       &trans       &trans       &trans &trans
&trans &trans     &trans       &trans       &trans       &trans         &kp C_PREV   &kp C_PP     &kp C_NEXT   &kp C_MUTE  &trans &studio_unlock
&trans &trans     &trans       &trans       &trans       &trans         &kp C_BRI_DN &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_UP &trans &trans
                                      &kp LGUI &trans &trans   &trans &trans &trans
                        >;
                };
        };
};
