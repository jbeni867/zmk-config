#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NAV  1
#define SYM  2

#define LEFT_HAND  0 1 2 3 4 5  12 13 14 15 16 17  24 25 26 27 28 29  36 37 38
#define RIGHT_HAND 6 7 8 9 10 11  18 19 20 21 22 23  30 31 32 33 34 35  39 40 41

/ {
        behaviors {
                hml: home_row_mod_left {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <RIGHT_HAND>;
                        hold-trigger-on-release;
                        display-name = "Left Home Row Mod";
                };

                hmr: home_row_mod_right {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <280>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        bindings = <&kp>, <&kp>;
                        hold-trigger-key-positions = <LEFT_HAND>;
                        hold-trigger-on-release;
                        display-name = "Right Home Row Mod";
                };
        };

        /*
         * NAV-only combos
         *
         * Bluetooth:
         *   1 + 2     -> Bluetooth profile 0
         *   2 + 3     -> Bluetooth profile 1
         *   3 + 4     -> Bluetooth profile 2
         *   4 + 5     -> Bluetooth profile 3
         *   6 + 7     -> Bluetooth profile 4
         *   8 + 9 + 0 -> Clear current Bluetooth profile
         *
         * Playback:
         *   H + J     -> Previous
         *   J + K     -> Play/Pause
         *   K + L     -> Next
         *
         * Media:
         *   N + M     -> Brightness Down
         *   M + ,     -> Volume Down
         *   , + .     -> Volume Up
         *   . + /     -> Brightness Up
         *   / + Del   -> Mute
         */
        combos {
                compatible = "zmk,combos";

                /*
                 * Bluetooth profiles
                 *
                 * These correspond to the physical top-row positions.
                 * Since they are limited to NAV, they trigger while the
                 * number row is active.
                 */

                combo_bt_0 {
                        timeout-ms = <50>;
                        key-positions = <1 2>;
                        layers = <NAV>;
                        bindings = <&bt BT_SEL 0>;
                };

                combo_bt_1 {
                        timeout-ms = <50>;
                        key-positions = <2 3>;
                        layers = <NAV>;
                        bindings = <&bt BT_SEL 1>;
                };

                combo_bt_2 {
                        timeout-ms = <50>;
                        key-positions = <3 4>;
                        layers = <NAV>;
                        bindings = <&bt BT_SEL 2>;
                };

                combo_bt_3 {
                        timeout-ms = <50>;
                        key-positions = <4 5>;
                        layers = <NAV>;
                        bindings = <&bt BT_SEL 3>;
                };

                combo_bt_4 {
                        timeout-ms = <50>;
                        key-positions = <6 7>;
                        layers = <NAV>;
                        bindings = <&bt BT_SEL 4>;
                };

                /*
                 * Intentionally requires three keys to make clearing
                 * a Bluetooth profile difficult to do accidentally.
                 */
                combo_bt_clear {
                        timeout-ms = <75>;
                        key-positions = <8 9 10>;
                        layers = <NAV>;
                        bindings = <&bt BT_CLR>;
                };


                /*
                 * Playback controls
                 *
                 * Physical H J K L positions on the right home row.
                 *
                 * NAV bindings:
                 * H = Left
                 * J = Down
                 * K = Up
                 * L = Right
                 */

                combo_previous {
                        timeout-ms = <50>;
                        key-positions = <18 19>;
                        layers = <NAV>;
                        bindings = <&kp C_PREV>;
                };

                combo_play_pause {
                        timeout-ms = <50>;
                        key-positions = <19 20>;
                        layers = <NAV>;
                        bindings = <&kp C_PP>;
                };

                combo_next {
                        timeout-ms = <50>;
                        key-positions = <20 21>;
                        layers = <NAV>;
                        bindings = <&kp C_NEXT>;
                };


                /*
                 * Volume / brightness controls
                 *
                 * Physical:
                 *
                 * N + M     = Brightness Down
                 * M + ,     = Volume Down
                 * , + .     = Volume Up
                 * . + /     = Brightness Up
                 * / + Del   = Mute
                 */

                combo_brightness_down {
                        timeout-ms = <50>;
                        key-positions = <30 31>;
                        layers = <NAV>;
                        bindings = <&kp C_BRI_DN>;
                };

                combo_volume_down {
                        timeout-ms = <50>;
                        key-positions = <31 32>;
                        layers = <NAV>;
                        bindings = <&kp C_VOL_DN>;
                };

                combo_volume_up {
                        timeout-ms = <50>;
                        key-positions = <32 33>;
                        layers = <NAV>;
                        bindings = <&kp C_VOL_UP>;
                };

                combo_brightness_up {
                        timeout-ms = <50>;
                        key-positions = <33 34>;
                        layers = <NAV>;
                        bindings = <&kp C_BRI_UP>;
                };

                combo_mute {
                        timeout-ms = <50>;
                        key-positions = <34 35>;
                        layers = <NAV>;
                        bindings = <&kp C_MUTE>;
                };
        };


        keymap {
                compatible = "zmk,keymap";

                /*
                 * ==========================================================
                 * BASE
                 * ==========================================================
                 *
                 * | TAB  Q     W     E      R T | Y U I     O     P     BSPC |
                 * | ESC  A/GUI S/ALT D/CTL  F G | H J K/CTL L/ALT ;/GUI '    |
                 * | SHFT Z     X     C      V B | N M ,     .     /     DEL  |
                 *                 | GUI NAV SPC | SHFT SYM ENT |
                 */

                base_layer {
                        display-name = "Base";

                        bindings = <
&kp TAB       &kp Q        &kp W       &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I         &kp O         &kp P          &kp BSPC
&kp ESC       &hml LGUI A  &hml LALT S &hml LCTRL D &kp F        &kp G        &kp H        &kp J        &hmr RCTRL K  &hmr RALT L   &hmr RGUI SEMI &kp SQT
&kp LSHFT     &kp Z        &kp X       &kp C        &kp V        &kp B        &kp N        &kp M        &kp COMMA     &kp DOT       &kp FSLH       &kp DEL
                                                        &kp LGUI &mo NAV &kp SPACE   &kp RSHFT &mo SYM &kp RET
                        >;
                };


                /*
                 * ==========================================================
                 * NAV
                 * ==========================================================
                 *
                 * | TAB   1   2   3   4    5 | 6     7     8     9    0 BSPC |
                 * | ESC  F1  F2  F3  F4   F5 | LEFT DOWN  UP  RIGHT F11 F12  |
                 * | SHFT F6  F7  F8  F9  F10 | HOME PGDN PGUP END  DEL DEL   |
                 *                    | GUI NAV SPC | SHFT SYM ENT |
                 *
                 *
                 * NAV COMBOS
                 * ----------------------------------------------------------
                 *
                 * Bluetooth:
                 *
                 *  1 + 2       BT Profile 0
                 *  2 + 3       BT Profile 1
                 *  3 + 4       BT Profile 2
                 *  4 + 5       BT Profile 3
                 *  6 + 7       BT Profile 4
                 *  8 + 9 + 0   Clear current BT profile
                 *
                 *
                 * Playback:
                 *
                 *  H + J       Previous
                 *  J + K       Play / Pause
                 *  K + L       Next
                 *
                 *
                 * Media:
                 *
                 *  N + M       Brightness Down
                 *  M + ,       Volume Down
                 *  , + .       Volume Up
                 *  . + /       Brightness Up
                 *  / + Del     Mute
                 */

                nav_layer {
                        display-name = "Nav";

                        bindings = <
&kp TAB       &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &kp N6       &kp N7       &kp N8       &kp N9       &kp N0        &kp BSPC
&kp ESC       &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &kp F11       &kp F12
&kp LSHFT     &kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &kp HOME     &kp PG_DN    &kp PG_UP    &kp END      &kp DEL       &kp DEL
                                                        &kp LGUI &trans &kp SPACE   &kp RSHFT &trans &kp RET
                        >;
                };


                /*
                 * ==========================================================
                 * SYMBOLS
                 * ==========================================================
                 *
                 * | TAB  ! @ # $ % | ^ & * ( ) BSPC |
                 * | ESC  ` { [ ( < | > ) ] } ' '    |
                 * | SHFT ~ - _ = + | \ | ; : ? DEL  |
                 *       | GUI NAV SPC | SHFT SYM ENT |
                 */

                symbol_layer {
                        display-name = "Symbols";

                        bindings = <
&kp TAB       &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT     &kp CARET     &kp AMPS      &kp ASTRK     &kp LPAR      &kp RPAR      &kp BSPC
&kp ESC       &kp GRAVE     &kp LBRC      &kp LBKT      &kp LPAR      &kp LT        &kp GT        &kp RPAR      &kp RBKT      &kp RBRC      &kp SQT       &kp SQT
&kp LSHFT     &kp TILDE     &kp MINUS     &kp UNDER     &kp EQUAL     &kp PLUS      &kp BSLH      &kp PIPE      &kp SEMI      &kp COLON     &kp QMARK     &kp DEL
                                                          &kp LGUI &mo NAV &kp SPACE   &kp RSHFT &trans &kp RET
                        >;
                };
        };
};
